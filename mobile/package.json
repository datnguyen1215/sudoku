{
  "name": "sudoku-mobile-android",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "cap:sync": "npx cap sync",
    "cap:sync:android": "npx cap sync android",
    "cap:android": "npx cap open android",
    "cap:run": "npx cap run android",
    "build": "./build.sh",
    "build:frontend": "cd ../server/frontend && npm run build",
    "android": "npx cap open android",
    "run:android": "npx cap run android",
    "clean": "cd android && ./gradlew clean",
    "assemble:debug": "cd android && ./gradlew assembleDebug",
    "assemble:release": "cd android && ./gradlew assembleRelease"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/cli": "^7.4.2",
    "@capacitor/core": "^7.4.2"
  }
}
