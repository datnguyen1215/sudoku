{
  "name": "sudoku-backend",
  "version": "1.0.0",
  "description": "Minimal backend API for Sudoku game",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "init-db": "node scripts/init-db.js",
    "migrate": "node scripts/migrate.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "uuid": "^11.1.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prettier": "^3.1.1"
  },
  "imports": {
    "#shared/*": "../../shared/*",
    "#src/*": "./src/*",
    "#utils/*": "./src/utils/*",
    "#db/*": "./src/db/*",
    "#routes/*": "./src/routes/*",
    "#services/*": "./src/services/*"
  }
}
